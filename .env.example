DATABASE_URL=
INTERNAL_SERVICE_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=download
R2_ENDPOINT=
REPLICATE_API_TOKEN=

# Metadata inspection uses Decodo when these credentials are present.
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_PROXY_HOST=us.decodo.com
DECODO_PROXY_PORT=10001

# Optional phase-specific URLs must point to an approved Decodo endpoint.
INSPECT_PROXY=
DOWNLOAD_PROXY=
# Media bytes stay direct unless this explicit switch is enabled.
DOWNLOAD_PROXY_FALLBACK_ENABLED=false
DECODO_PROXY_COUNTRY=us
DECODO_PROXY_SESSION=
DECODO_PROXY_SESSION_DURATION=30
